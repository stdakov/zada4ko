# ==========================================================================
# zada4ko.com — static site (no PHP)
# ==========================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # drop the www.
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # force https
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Each language has its own address. Old "?lang=xx" links move there for good,
    # so search engines index /fr/ instead of a duplicate of the home page.
    RewriteCond %{QUERY_STRING} (^|&)lang=bg(&|$) [NC]
    RewriteRule ^(index\.html)?$ /? [R=301,L]
    RewriteCond %{QUERY_STRING} (^|&)lang=(en|de|fr|it|es|pt|nl|sv|el|ro|pl)(&|$) [NC]
    RewriteRule ^(index\.html)?$ /%2/? [R=301,L]

    # strip a trailing slash unless it is a real directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # No catch-all to index.html: the app routes with "#/…", so a path that is
    # not a real file is a genuine 404. Answering 200 with the home page made
    # search engines see endless duplicate copies of it ("soft 404").
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml            .svg
    AddCharset UTF-8                 .html .css .js .json .webmanifest .xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 7 days"
    ExpiresByType application/javascript    "access plus 7 days"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    # the shell and the worker must always be revalidated
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /index.html
